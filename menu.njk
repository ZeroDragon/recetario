---
layout: base.njk
title: Menú semanal
---
<h1>Menú semanal</h1>

<div id="menu-app">
  <!-- Selector de menú -->
  <div class="menu-toolbar">
    <label for="menu-select">Menú:</label>
    <select id="menu-select"></select>
    <button id="btn-nuevo" type="button">+ Nuevo</button>
    <button id="btn-editar" type="button" disabled>Editar</button>
    <button id="btn-clonar" type="button" disabled>Clonar</button>
    <button id="btn-eliminar" type="button" disabled>Eliminar</button>
  </div>

  <!-- Editor de menú (tabla editable) -->
  <section id="menu-editor" hidden>
    <h2 id="editor-titulo">Nuevo menú</h2>
    <input type="text" id="menu-nombre" placeholder="Nombre del menú (ej. Semana 1)">

    <!-- Calculadora GMB/GET (Harris-Benedict) -->
    <fieldset class="calculadora">
      <legend>🧮 Calculadora GMB/GET (Harris-Benedict)</legend>
      <div class="calculadora-fila">
        <label for="calc-sexo">Sexo</label>
        <select id="calc-sexo">
          <option value="m">Hombre</option>
          <option value="f">Mujer</option>
        </select>
        <label for="calc-peso">Peso (kg)</label>
        <input type="number" id="calc-peso" min="0" step="0.1" placeholder="80">
        <label for="calc-altura">Altura (cm)</label>
        <input type="number" id="calc-altura" min="0" step="1" placeholder="175">
        <label for="calc-edad">Edad</label>
        <input type="number" id="calc-edad" min="0" step="1" placeholder="30">
        <label for="calc-actividad">Actividad</label>
        <select id="calc-actividad">
          <option value="1.2">Sedentario</option>
          <option value="1.375">Ligero</option>
          <option value="1.55">Moderado</option>
          <option value="1.725">Muy activo</option>
          <option value="1.9">Extra activo</option>
        </select>
        <button id="btn-calcular" type="button">Calcular</button>
      </div>
      <p id="calc-resultado" class="calc-resultado" hidden>
        <span class="calc-gmb"></span> · <span class="calc-get"></span>
      </p>
      <div class="calculadora-acciones">
        <button id="btn-usar-get" type="button" disabled>Usar GET como base → kCal</button>
      </div>

      <details class="detalle-actividad">
        <summary>¿Qué significa cada nivel de actividad?</summary>
        <table class="tabla-actividad">
          <thead>
            <tr>
              <th>Factor</th>
              <th>Nivel</th>
              <th>Descripción</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>1.2</td><td>Sedentario</td><td>Sin actividad física (trabajo de escritorio, poco movimiento)</td></tr>
            <tr><td>1.375</td><td>Ligero</td><td>~30 min de ejercicio al día (1–3 días a la semana)</td></tr>
            <tr><td>1.55</td><td>Moderado</td><td>30–60 min de ejercicio al día (3–5 días a la semana)</td></tr>
            <tr><td>1.725</td><td>Muy activo</td><td>60+ min de ejercicio al día (6–7 días a la semana)</td></tr>
            <tr><td>1.9</td><td>Extra activo</td><td>2+ horas al día o trabajo físico intenso (doble sesión)</td></tr>
          </tbody>
        </table>
      </details>
    </fieldset>

    <fieldset class="generador">
      <legend>Objetivo diario</legend>
      <label for="kcal-min">kCal mín</label>
      <input type="number" id="kcal-min" min="0" step="50" placeholder="1800">
      <label for="kcal-max">kCal máx</label>
      <input type="number" id="kcal-max" min="0" step="50" placeholder="2200">
      <select id="regimen-select">
        <option value="">— Régimen —</option>
        <option value="mantenimiento">Equilibrio general (Mantenimiento) · 30% P · 30% G · 40% C</option>
        <option value="definicion">Definición / Pérdida de grasa · 35% P · 25% G · 40% C</option>
        <option value="volumen">Aumento muscular (Volumen) · 25% P · 25% G · 50% C</option>
      </select>
      <button id="btn-auto" type="button">✨ Auto generar</button>
    </fieldset>

    <table id="menu-tabla">
      <thead>
        <tr>
          <th>Día</th>
          <th>Desayuno</th>
          <th>Post-entreno</th>
          <th>Comida</th>
          <th>Cena</th>
          <th>Totales/día</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
    <div class="menu-actions">
      <button id="btn-guardar" type="button">Guardar</button>
      <button id="btn-cancelar" type="button">Cancelar</button>
    </div>
  </section>

  <!-- Render del menú seleccionado -->
  <section id="menu-render">
    <h2 id="render-titulo"></h2>
    <div id="render-contenido"></div>
  </section>
</div>

<script>
  window.RECETAS = {{ recetas | dump | safe }};
</script>
<script src="{{ '/js/menu.js' | url }}"></script>
